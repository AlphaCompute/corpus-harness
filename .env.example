CORPUS_BASE_URL=https://your-gateway/v1
CORPUS_API_KEY=
# Optional. Unset means corpus uses the first model the provider lists.
CORPUS_MODEL=

# Tool calls one turn may make before it gives back a partial answer. Every step resends
# the whole conversation, so the cost of a turn grows with the square of this.
CORPUS_MAX_STEPS=30

# Providers beyond the one above, as a route table. The same document the swarm
# worker reads, so a provider configured once is addressable from both under the
# same route names and model ids. A model is then named `provider/model`;
# anything without a recognised prefix still goes to CORPUS_BASE_URL.
# `corpus models` prints every route and what it serves.
#
# CORPUS_PROVIDERS='{"providers":{"redpill":{"baseURL":"https://api.redpill.ai/v1",
#   "apiKeyEnv":"REDPILL_API_KEY","models":[{"id":"z-ai/glm-5.3"}]}}}'
# CORPUS_PROVIDERS_FILE=./providers.json   # the same document, out of a file

# How hard the model is asked to think, named as its route spells the levels.
# `--reasoning` on the command line overrides it. A level the chosen model does
# not offer is refused before the first request rather than quietly ignored.
# CORPUS_REASONING=high
